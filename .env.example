# Sandbox ONLY. Never put live credentials here.
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ANTHROPIC_API_KEY=
DATABASE_URL=
# Guards the merchant console and the policy API (at least 16 characters). Those routes answer 503 until it is set.
ADMIN_TOKEN=
# Optional. Read-only access to the console for reviewers. At least 16 characters and different from ADMIN_TOKEN.
JUDGE_TOKEN=
# Set to true to enable the "Reset demo data" button (admin only). Leave false anywhere the data matters.
ALLOW_DEMO_RESET=false
# Set to true ONLY when deployed behind a proxy you control (e.g. Render), so rate limits read X-Forwarded-For.
TRUST_PROXY=false
# The case agent stops calling the model for the rest of the day once estimated spend reaches this many US dollars.
MODEL_DAILY_CAP_USD=5
